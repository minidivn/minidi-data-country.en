:00:00Z","occupation":"actor"},"t":"person","u":"https://www.wikidata.org/wiki/Q7542"},{"d":"American voice actor, animator, director, writer and comedian","dl":null,"id":"Q4408","l":"Mr. Lawrence","ll":null,"m":{"birth_date":"1969-01-01T00:00:00Z","occupation":"television actor"},"t":"person","u":"https://www.wikidata.org/wiki/Q4408"},{"d":"American computer scientist (1952 – 2015)","dl":null,"id":"Q7563","l":"Joyce K. Reynolds","ll":null,"m":{"birth_date":"1952-03-08T00:00:00Z","death_date":"2015-12-28T00:00:00Z","occupation":"engineer"},"t":"person","u":"https://www.wikidata.org/wiki/Q7563"},{"d":"American alpine skier (born 1984)","dl":null,"id":"Q10068","l":"Lindsey Vonn","ll":null,"m":{"birth_date":"1984-10-18T00:00:00Z","occupation":"television presenter","summary":"Lindsey Caroline Vonn (née Kildow ; born October 18, 1984) is an American alpine ski racer. She won four World Cup overall championships with titles in 2008, 2009, 2010, and 2012. Vonn won the gold medal in downhill at the 2010 Winter Olympics, the first one for an American woman. She also won a record eight World Cup season titles in the downhill discipline (2008–2013, 2015, 2016), five titles in super-G (2009–2012, 2015), and three consecutive titles in the combined (2010–2012). In 2016, she won her 20th World Cup crystal globe title, the overall record for men or women, surpassing Ingemar Stenmark of Sweden, who won 19 globes from 1975 to 1984. She has the third highest super ranking of all skiers, men or women."},"t":"person","u":"https://www.wikidata.org/wiki/Q10068"},{"d":"American stand-up comedian, radio personality, and actor (1969-2011)","dl":null,"id":"Q4145","l":"Patrice O'Neal","ll":null,"m":{"birth_date":"1969-12-07T00:00:00Z","death_date":"2011-11-29T00:00:00Z","occupation":"actor"},"t":"person","u":"https://www.wikidata.org/wiki/Q4145"},{"d":"American film and television actor","dl":null,"id":"Q4293","l":"Jon Abrahams","ll":null,"m":{"birth_date":"1977-10-29T00:00:00Z","occupation":"film director"},"t":"person","u":"https://www.wikidata.org/wiki/Q4293"},{"d":"American former professor, co-founder of Wikipedia, founder of Citizendium and other projects (born 1968)","dl":null,"id":"Q185","l":"Q185","ll":null,"m":{"birth_date":"1968-07-16T00:00:00Z","occupation":"computer scientist","summary":"Lawrence Mark Sanger (born July 16, 1968) is an American Internet project developer and philosopher who co-founded Wikipedia with Jimmy Wales. Sanger coined the name Wikipedia and provided initial drafts for many of its early guidelines, including the \"Neutral point of view\" and \"Ignore all rules\" policies. Prior to Wikipedia, he was the editor-in-chief of Nupedia, an online encyclopedia which was the predecessor of Wikipedia. He later worked on other encyclopedic projects, including the Encyclopedia of Earth, Citizendium, Everipedia, and Ballotpedia. Sanger's other interests include theology and philosophy such as epistemology, early modern philosophy, and ethics. He taught philosophy at Ohio State University. While in college, Sanger began using the Internet for educational purposes and joined the online encyclopedia Nupedia as editor-in-chief in 2000."},"t":"person","u":"https://www.wikidata.org/wiki/Q185"},{"d":"American tennis player (born 1971)","dl":null,"id":"Q9446","l":"Pete Sampras","ll":null,"m":{"birth_date":"1971-08-12T00:00:00Z","occupation":"tennis player"},"t":"person","u":"https://www.wikidata.org/wiki/Q9446"},{"d":"American rock musician (1967–1994)","dl":null,"id":"Q8446","l":"Kurt Cobain","ll":null,"m":{"birth_date":"1967-02-20T00:00:00Z","death_date":"1994-04-05T00:00:00Z","occupation":"rock singer"},"t":"person","u":"https://www.wikidata.org/wiki/Q8446"},{"d":"visual effects supervisor","dl":null,"id":"Q8599","l":"Eric Barba","ll":null,"m":{"birth_date":"2000-01-01T00:00:00Z","occupation":"visual effects supervisor"},"t":"person","u":"https://www.wikidata.org/wiki/Q8599"},{"d":"American computer scientist","dl":null,"id":"Q11775",