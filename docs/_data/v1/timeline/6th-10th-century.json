0:00Z","start_time":"0700-01-01T00:00:00Z"},"t":"event","u":"https://www.wikidata.org/wiki/Q852431"},{"d":"Archbishop of York","dl":null,"id":"Q3049131","l":"Ecgbert","ll":null,"m":{"birth_date":"0678-01-01T00:00:00Z","death_date":"0766-11-23T00:00:00Z","occupation":"Catholic priest"},"t":"person","u":"https://www.wikidata.org/wiki/Q3049131"},{"d":"king of the Anglo-Saxons (r. 899–924)","dl":null,"id":"Q187114","l":"Edward the Elder","ll":null,"m":{"birth_date":"0874-06-01T00:00:00Z","death_date":"0924-07-22T00:00:00Z","occupation":"sovereign","summary":"Edward the Elder (870s? – 17 July 924) was King of the Anglo-Saxons from 899 until his death in 924. He was the elder son of Alfred the Great and his wife Ealhswith. When Edward succeeded to the throne, he had to defeat a challenge from his cousin Æthelwold, who had a strong claim to the throne as the son of Alfred's elder brother and predecessor, Æthelred I. Alfred had succeeded Æthelred as king of Wessex in 871, and almost faced defeat against the Danish Vikings until his decisive victory at the Battle of Edington in 878. After the battle, the Vikings still ruled Northumbria, East Anglia and eastern Mercia, leaving only Wessex and western Mercia under Anglo-Saxon control."},"t":"person","u":"https://www.wikidata.org/wiki/Q187114"},{"d":"Potteryware of Latte Period in the Marianas","dl":null,"id":"Q137474435","l":"Latte Plainware","ll":null,"m":{"end_time":"1700-01-01T00:00:00Z","start_time":"0900-01-01T00:00:00Z"},"t":"event","u":"https://www.wikidata.org/wiki/Q137474435"}],"entity_count":12,"label":"6th 10th century","period":"6th-10th-century"}